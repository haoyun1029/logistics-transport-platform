# 示例配置：仅填写本机开发环境值，勿提交真实密钥
SPRING_PROFILES_ACTIVE=local
DB_HOST=192.168.146.128
DB_PORT=3306
DB_NAME=logistics_system
DB_USERNAME=logistics_app
DB_PASSWORD=replace_me
APP_BOOTSTRAP_TOKEN=replace_with_a_long_random_setup_token
# Explicitly enable only for a clearly labelled, non-production demonstration.
DEMO_MODE=false
KAFKA_BOOTSTRAP_SERVERS=192.168.146.128:9092
KAFKA_GPS_TOPIC=logistics.gps.raw
FLINK_REST_URL=http://192.168.146.128:8081
MONGODB_HOST=192.168.146.128
MONGODB_PORT=27017
HDFS_DEFAULT_FS=hdfs://192.168.146.128:8020
HDFS_WEB_URL=http://192.168.146.128:9870
HDFS_LATEST_MANIFEST=/logistics/transport-statistics/latest.json
HDFS_DATA_HTTP_PORT=9864
AMAP_JS_API_KEY=replace_me
AMAP_JS_SECURITY_CODE=replace_with_browser_security_code_if_required
AMAP_WEB_SERVICE_KEY=replace_me
AMAP_DRIVING_ENDPOINT=https://restapi.amap.com/v3/direction/driving
AMAP_TRUCK_ENDPOINT=https://restapi.amap.com/v4/direction/truck
OSRM_ROAD_ENDPOINT=https://router.project-osrm.org/route/v1/driving
# 如当前高德方案要求安全密钥/代理，请按官方文档配置；不要将其硬编码到前端仓库。

# Optional Windows SSH tunnel to VM-local MongoDB
MONGO_URI=mongodb://127.0.0.1:27018/?serverSelectionTimeoutMS=1200
MONGO_DATABASE=logistics_system
MONGO_TASK_ID=DEMO-2026-002
HDFS_STATISTICS_PATH=/logistics/transport-statistics/export_date=YYYY-MM-DD/run=RUN_ID/od-statistics.csv
